/* ============================================================
   universal-converter — application stylesheet
   Apply via qApp->setStyleSheet(...) in main(), loaded from
   a .qrc resource (":/styles/style.qss").

   Accent color used throughout: #3daee9
   Change every occurrence of #3daee9 to re-brand.
   ============================================================ */

/* ---- Base ---- */
QWidget {
    background-color: #2b2e33;
    color: #e6e6e6;
    font-family: "Noto Sans", "Segoe UI";
    font-size: 10pt;
}

QMainWindow {
    background-color: #23262b;
}

QMainWindow::separator {
    background-color: #1a1c1f;
    width: 1px;
    height: 1px;
}

/* ---- Panels (SourcePanel / FormatPanel / OutputPanel) ---- */
QGroupBox {
    background-color: #2b2e33;
    border: 1px solid #3a3d42;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #3daee9;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #383c42;
    color: #e6e6e6;
    border: 1px solid #4a4e55;
    border-radius: 4px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #454a52;
    border-color: #3daee9;
}

QPushButton:pressed {
    background-color: #2f3339;
}

QPushButton:disabled {
    background-color: #2b2e33;
    color: #6a6e75;
    border-color: #3a3d42;
}

QPushButton#primaryButton,
QPushButton[class="primary"] {
    background-color: #3daee9;
    color: #0d1114;
    font-weight: 600;
    border: none;
}

QPushButton#primaryButton:hover,
QPushButton[class="primary"]:hover {
    background-color: #57bbee;
}

/* ---- Labels ---- */
QLabel {
    background: transparent;
    color: #e6e6e6;
}

QLabel[class="muted"] {
    color: #9a9ea5;
}

/* ---- Line edits / text inputs ---- */
QLineEdit {
    background-color: #1f2226;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 4px 8px;
    selection-background-color: #3daee9;
    selection-color: #0d1114;
}

QLineEdit:focus {
    border-color: #3daee9;
}

QLineEdit:disabled {
    color: #6a6e75;
}

/* ---- Combo boxes (format selection) ---- */
QComboBox {
    background-color: #1f2226;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 22px;
}

QComboBox:hover {
    border-color: #3daee9;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #1f2226;
    border: 1px solid #3a3d42;
    selection-background-color: #3daee9;
    selection-color: #0d1114;
    outline: none;
}

/* ---- List widget (file queue) ---- */
QListWidget {
    background-color: #1f2226;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    padding: 2px;
    outline: none;
}

QListWidget::item {
    padding: 2px;
    border-radius: 3px;
}

QListWidget::item:selected {
    background-color: #33465a;
    color: #e6e6e6;
}

QListWidget::item:hover {
    background-color: #2f3339;
}

/* ---- Progress bars ---- */
QProgressBar {
    background-color: #1f2226;
    border: 1px solid #3a3d42;
    border-radius: 4px;
    text-align: center;
    color: #e6e6e6;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #3daee9;
    border-radius: 3px;
}

/* ---- Checkboxes / radio buttons ---- */
QCheckBox, QRadioButton {
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4a4e55;
    background-color: #1f2226;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #3daee9;
    border-color: #3daee9;
}

/* ---- Scrollbars ---- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4a4e55;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #3daee9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #4a4e55;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #3daee9;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Tooltips ---- */
QToolTip {
    background-color: #1f2226;
    color: #e6e6e6;
    border: 1px solid #3daee9;
    padding: 4px 6px;
    border-radius: 3px;
}

/* ---- Menu bar / menus (if you add one) ---- */
QMenuBar {
    background-color: #23262b;
    color: #e6e6e6;
}

QMenuBar::item:selected {
    background-color: #383c42;
}

QMenu {
    background-color: #2b2e33;
    border: 1px solid #3a3d42;
}

QMenu::item:selected {
    background-color: #33465a;
}

/* ---- Status bar ---- */
QStatusBar {
    background-color: #23262b;
    color: #9a9ea5;
}
